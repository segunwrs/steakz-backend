# Copy to .env and change the values
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
# SQLite database file (created automatically)
DB_FILE=./data/steakz.db
# Password given to every demo account when seeding
SEED_PASSWORD=Steakz@2026
# Comma-separated list of allowed front-end origins (leave empty to allow all in dev)
CORS_ORIGIN=
